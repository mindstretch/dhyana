{
  "version": 2,
  "builds": [
    { "src": "api/subscribe.js", "use": "@vercel/node" },
    { "src": "api/checkin.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/subscribe", "dest": "/api/subscribe.js" },
    { "src": "/api/checkin", "dest": "/api/checkin.js" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ]
}
